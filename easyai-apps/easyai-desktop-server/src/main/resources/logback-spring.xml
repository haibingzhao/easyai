<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- Console appender: plain pattern, captured by the Electron main process
         into {userData}/logs/backend-stdout.log (the single log destination;
         a separate file appender would duplicate it and, worse, make startup
         fatal whenever its directory is not writable). -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%t] %-5level %logger{0} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="org.springframework.ai.converter.BeanOutputConverter" level="OFF"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
