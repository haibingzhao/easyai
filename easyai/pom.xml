            </dependency>
            <!-- easyai-common modules -->
            <dependency>
                <groupId>com.easy</groupId>
                <artifactId>easyai-common-core</artifactId>
                <version>${revision}</version>
            </dependency>
            <dependency>
                <groupId>com.easy</groupId>
