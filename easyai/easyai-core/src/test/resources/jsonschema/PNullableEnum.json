{
  "$schema" : "https://json-schema.org/draft/2020-12/schema",
  "type" : "object",
  "properties" : {
    "items" : {
      "type" : "array",
      "items" : {
        "type" : "object",
        "properties" : {
          "a" : {
            "type" : [ "string", "null" ]
          },
          "b" : {
            "type" : [ "integer", "null" ],
            "format" : "int32"
          }
        },
        "additionalProperties" : false
      }
    },
    "mode" : {
      "anyOf" : [ {
        "type" : "null"
      }, {
        "type" : "string",
        "enum" : [ "FAST", "BALANCED", "QUALITY" ]
      } ]
    }
  },
  "required" : [ "items" ],
  "additionalProperties" : false
}